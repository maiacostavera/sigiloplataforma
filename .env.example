# Secreto para firmar las sesiones. Generalo con: openssl rand -base64 32
AUTH_SECRET=

# ---- Base de datos ----
# Dueño de la base: SOLO para migraciones (npm run db:migrar) y para crear la
# base de tests. La aplicación nunca usa esta conexión.
DATABASE_URL_DUENO=postgres://sigilo_dueno:CAMBIAR@localhost:5432/sigilo

# La aplicación se conecta SIEMPRE como app_sigilo. El rol lo crea la migración
# 0005 con contraseña 'cambiar': en producción cambiala con
#   alter role app_sigilo password '...';
DATABASE_URL=postgres://app_sigilo:cambiar@localhost:5432/sigilo

# ---- Revisor de prueba (npm run db:seed) ----
SEED_EMAIL=revisor@ejemplo.com.ar
SEED_CLAVE=sigilo-demo
