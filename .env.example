# Secreto para firmar las sesiones. Generalo con: openssl rand -base64 32
AUTH_SECRET=

# ---- Base de datos ----
# Dueño de la base: SOLO para migraciones (npm run db:migrar) y para crear la
# base de tests. La aplicación nunca usa esta conexión.
DATABASE_URL_DUENO=postgres://sigilo_dueno:CAMBIAR@localhost:5432/sigilo

# La aplicación se conecta SIEMPRE como app_sigilo. El rol lo crea la migración
# 0005 con contraseña 'cambiar': en producción cambiala con
#   alter role app_sigilo password '...';
APP_DATABASE_URL=postgres://app_sigilo:cambiar@localhost:5432/sigilo

# ---- Revisor de prueba (npm run db:seed) ----
SEED_EMAIL=revisor@ejemplo.com.ar
SEED_CLAVE=sigilo-demo

# ---- Producción ----
# Contraseña real de app_sigilo. Si está definida, `db:migrar` crea el rol con
# ella (o se la cambia). Usá la misma en DATABASE_URL.
APP_SIGILO_CLAVE=

# Storage: local (carpeta) o s3 (cualquier S3-compatible: AWS, Cloudflare R2…)
STORAGE_DRIVER=local
ALMACEN_DIR=./almacen
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Máximo por envío del portal, en MB. Por defecto 50 (4 en Vercel, que corta
# los requests de más de 4,5 MB).
LIMITE_ENVIO_MB=
